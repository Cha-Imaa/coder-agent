# --- LLM providers (all free tiers) ---
GROQ_API_KEY=
GOOGLE_API_KEY=

# Model in "provider:model" form, understood by langchain's init_chat_model.
# Primary (fast, free): groq. Fallback when Groq rate-limits: google_genai.
CODER_MODEL=groq:openai/gpt-oss-120b
CODER_FALLBACK_MODEL=google_genai:gemini-2.5-flash

# --- Observability (LangSmith free tier) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coder-agent

# --- Agent behaviour ---
CODER_MAX_ITERATIONS=4
CODER_COMMAND_TIMEOUT=120

# --- Sandbox: where the agent's shell commands run ---
# local  = on this machine behind a denylist and a timeout (default).
# docker = a fresh container per command, no network, only the repo mounted at /work.
#          Needs a running Docker daemon; the default image is built from
#          src/coder_agent/sandbox/Dockerfile on first use. `--sandbox docker` overrides per run.
CODER_SANDBOX_MODE=local
CODER_SANDBOX_IMAGE=coder-sandbox
CODER_SANDBOX_NETWORK=none
CODER_SANDBOX_MEMORY=1g
CODER_SANDBOX_CPUS=1.0

# --- Retrieval index ---
# Files above the size cap are skipped; chunks are sized for a 512-token embedding model.
CODER_INDEX_MAX_FILE_KB=512
CODER_CHUNK_MAX_CHARS=1500
CODER_CHUNK_WINDOW_LINES=60
CODER_CHUNK_OVERLAP_LINES=10
# Local embedding model (fastembed, CPU). Downloaded once to ~/.coder-agent/models.
# Prefer float32 models: fastembed's quantised BAAI/bge-small-en-v1.5 is 14x slower on CPUs without VNNI.
CODER_EMBEDDING_MODEL=snowflake/snowflake-arctic-embed-xs
CODER_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
CODER_EMBED_BATCH_SIZE=64
# Retrieval: hybrid | dense | bm25 | off. k chunks are shown to the planner, capped by chars.
CODER_RETRIEVAL_MODE=hybrid
CODER_RETRIEVAL_CANDIDATES=20
CODER_RETRIEVAL_K=6
CODER_RETRIEVAL_CONTEXT_CHARS=6000
# Optional cross-encoder second stage: re-scores the top candidates before the planner sees k.
# ~1.5 s per query on a laptop CPU; the model (80 MB) is downloaded once to ~/.coder-agent/models.
CODER_RERANK=false
CODER_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CODER_RERANK_CANDIDATES=20
