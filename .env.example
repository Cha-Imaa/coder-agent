# --- LLM providers (all free tiers) ---
GROQ_API_KEY=
GOOGLE_API_KEY=

# Model in "provider:model" form, understood by langchain's init_chat_model.
# Primary (fast, free): groq. Fallback when Groq rate-limits: google_genai.
CODER_MODEL=groq:openai/gpt-oss-120b
CODER_FALLBACK_MODEL=google_genai:gemini-2.5-flash

# --- Observability (LangSmith free tier) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coder-agent

# --- Agent behaviour ---
CODER_MAX_ITERATIONS=4
CODER_COMMAND_TIMEOUT=120

# --- Retrieval index ---
# Files above the size cap are skipped; chunks are sized for a 512-token embedding model.
CODER_INDEX_MAX_FILE_KB=512
CODER_CHUNK_MAX_CHARS=1500
CODER_CHUNK_WINDOW_LINES=60
CODER_CHUNK_OVERLAP_LINES=10
